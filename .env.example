# ============================================================
# PBCManage Docker 环境变量配置
# 复制此文件为 .env 并填写实际值后再执行 docker compose up
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
# MySQL root 密码（仅容器内部使用）
MYSQL_ROOT_PASSWORD=ChangeMe_RootPass123!

# 应用数据库名（默认 pbc_manage）
MYSQL_DATABASE=pbc_manage

# 应用数据库用户
MYSQL_USER=pbc_user

# 应用数据库密码（请修改为强密码）
MYSQL_PASSWORD=ChangeMe_DbPass456!

# ── DASLink SSO ─────────────────────────────────────────────
# 是否启用 DASLink 单点登录（true/false）
DASLINK_ENABLED=true

# 测试环境: http://digital-base.xxh.dbappsecurity.com.cn
# 正式环境: https://dl.dbappsecurity.com.cn
DASLINK_HOST=https://dl.dbappsecurity.com.cn

# DASLink 应用凭证（在 DASLink 平台注册后获取）
DASLINK_APP_ID=your_app_id
DASLINK_APP_SECRET=your_app_secret

# ── CORS ────────────────────────────────────────────────────
# 生产环境前端域名（多个用逗号分隔）
CORS_ORIGINS=https://pbc.das-security.cn

# ── 前端 ────────────────────────────────────────────────────
# 前端对外暴露的端口（默认 80）
FRONTEND_PORT=80
